#!/usr/bin/env python3
"""Check the series' adoptions against the texts they pin.

Two checks. A001 is the older and narrower: EEP 1's substitution table
must still cover the pinned PEP 1. A002 is EEP 8's, and covers every
adoption in the series: each pinned file must still resolve at the
revision the EEP names.

EEP 1's rule of adoption says "PEP 1 is read with the substitutions
below", which claims the table is complete. Nothing checked that claim,
and it was false: the PEP 12 row said the template was vacant for four
commits after EEP 3 filled it, and an audit by hand found seven further
terms with no row at all.

Doing this mechanically needs the pinned text, and keeping a copy of it
in the repository is exactly what EEP 1 refused when it chose a pin over
a copy: "A copy drifts from its original silently. A pin shows drift
plainly." So this fetches the pinned revision instead, and holds no copy.

The pin is read out of EEP 1 rather than written here, so the document
and the check cannot disagree about which revision is adopted.

Without a network the check cannot run. It says so and exits 0, the way
tools/check-python treats a missing pylint: nobody is blocked offline,
and CI has a network so the check is not skipped where it decides
anything.

Usage:
    tools/check-adoption

Exits 0 when everything checked passes or nothing could be fetched,
1 when a term has no row or a pin does not resolve, 2 when the
repository is not readable.
"""

import difflib
import http.client
import os
import re
import sys
import urllib.error
import urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
EEP1 = os.path.join(REPO, "eeps", "eep-0001.md")
EEPS = os.path.join(REPO, "eeps")
RAW = "https://raw.githubusercontent.com/python/peps/%s/peps/pep-0001.rst"
RAW_ANY = "https://raw.githubusercontent.com/%s/%s/%s/%s"

# EEP 8 fixes the form of the sentence that announces a pin, so that
# every adoption in the series can be found without this tool knowing
# which EEPs make one.  Before EEP 8 this tool knew about EEP 1 alone,
# and EEP 5's and EEP 6's tables were checked by nothing.
PIN_SENTENCE = re.compile(
    r"at revision `([0-9a-f]{40})` of `([^`]+)` in "
    r"`github\.com/([\w.-]+)/([\w.-]+)`")

# EEP 8 allows a working copy only where a tool has to read the file
# locally, and requires it to name the revision it came from and every
# divergence from it.  R004 in tools/check-eeps reads only divergences
# that declare themselves, so it cannot see one that declares nothing.
# This finds the upstream text and diffs against it.
WORKING_COPY = re.compile(
    r"working copy of `([^`]+)` at revision `([0-9a-f]{40})` in "
    r"`github\.com/([\w.-]+)/([\w.-]+)`")

MARKER = "# Edison:"

# Named things PEP 1 refers to that a substitution has to answer for.
# Cross-references to other PEPs are found in the text itself.
NAMED = [
    "Contributing Guide", "Steering Council", "core developer",
    "PEP editors", "Typing Council", "PyPA", "BDFL", "Code of Conduct",
    "GitHub", "Discourse", "issue tracker", "Python-Version", "Topic",
    "devguide",
]


def pin(text):
    """The revision EEP 1 adopts, read from EEP 1."""
    found = re.search(r"revision\s*\n?`([0-9a-f]{40})`", text)
    return found.group(1) if found else None


def complete(text):
    """Whether the fetched text is a whole PEP 1 and not a fragment.

    A truncated download is worse than a failed one. It has fewer terms
    in it, so fewer would be reported missing, and the check would pass
    for the wrong reason. Both ends are checked before it is trusted.
    """
    if not text or len(text) < 20000:
        return False
    # "PEP: 1" alone would also match PEP 13's header.
    return text.startswith("PEP: 1\n") and \
        "Title: PEP Purpose and Guidelines" in text[:200] and \
        "Copyright" in text[-2000:]


def fetch(revision):
    """The pinned text, or None when it cannot be reached whole."""
    for _ in range(3):
        try:
            with urllib.request.urlopen(RAW % revision,
                                        timeout=30) as response:
                text = response.read().decode("utf-8")
        except (urllib.error.URLError, http.client.HTTPException,
                OSError, ValueError):
            continue
        if complete(text):
            return text
    return None


def terms(pep1):
    """Every term the pinned text refers to, with how often."""
    found = {}
    for match in re.finditer(r":pep:`(?:[^`<]*<)?(\d+)", pep1):
        name = "PEP " + match.group(1)
        found[name] = found.get(name, 0) + 1
    for name in NAMED:
        count = len(re.findall(re.escape(name), pep1))
        if count:
            found[name] = count
    return found


def table(eep1):
    """Just the substitution table's rows.

    The search has to be confined to the table. Matching a term anywhere
    in EEP 1 passes on the term being mentioned in prose or in a change
    history entry, which is not the same as it having a row, and that is
    the claim being checked.
    """
    section = re.search(r"^### Substitutions\s*$(.*?)^#{2,3} ",
                        eep1, re.M | re.S)
    if not section:
        return ""
    return "\n".join(line for line in section.group(1).split("\n")
                     if line.startswith("|"))


def covered_by_rule(eep1):
    """The PEPs EEP 1's catch-all row answers for."""
    row = re.search(r"any other PEP that PEP 1 cites \(([^)]*)\)", eep1)
    if not row:
        return set()
    return {"PEP " + n.strip() for n in row.group(1).split(",")}


def adoptions():
    """Every pin in the series, as (eep, revision, path, owner, repo).

    Whitespace is collapsed first so that a pin which wraps across lines
    reads the same as one that does not.
    """
    found = []
    if not os.path.isdir(EEPS):
        return found
    for name in sorted(os.listdir(EEPS)):
        if not re.match(r"^eep-\d{4}\.md$", name):
            continue
        with open(os.path.join(EEPS, name), encoding="utf-8") as handle:
            flat = re.sub(r"\s+", " ", handle.read())
        for match in PIN_SENTENCE.finditer(flat):
            revision, path, owner, repo = match.groups()
            found.append((name, revision, path, owner, repo))
    return found


def fetch_file(owner, repo, revision, path):
    """The pinned file's text, False when it is not there, None when
    the network could not be reached at all.

    The three outcomes are kept apart on purpose: a machine with no
    network must not be told its pins are broken.
    """
    url = RAW_ANY % (owner, repo, revision, path)
    for _ in range(3):
        try:
            with urllib.request.urlopen(url, timeout=30) as response:
                return response.read().decode("utf-8")
        except urllib.error.HTTPError:
            return False
        except (urllib.error.URLError, http.client.HTTPException,
                OSError, ValueError, UnicodeDecodeError):
            continue
    return None


def resolves(owner, repo, revision, path):
    """Whether the pinned file can still be read at that revision."""
    text = fetch_file(owner, repo, revision, path)
    if text is None:
        return None
    return text is not False


def check_pins():
    """A002.  Report every pin that no longer resolves."""
    pins = adoptions()
    if not pins:
        print("No adoption in the series names a pinned revision.")
        return 0
    broken, unreachable = [], 0
    for name, revision, path, owner, repo in pins:
        state = resolves(owner, repo, revision, path)
        if state is None:
            unreachable += 1
        elif not state:
            broken.append((name, revision, path, owner, repo))
    for name, revision, path, owner, repo in broken:
        print("A002  eeps/%s  %s does not resolve in %s/%s at %s"
              % (name, path, owner, repo, revision))
    if broken:
        return 1
    if unreachable:
        print("%d of %d pin(s) could not be reached, so they were not "
              "checked." % (unreachable, len(pins)))
        return 0
    print("%d pin(s) checked, all resolve." % len(pins))
    return 0


def working_copies():
    """Every declared working copy, as (path, upstream, rev, owner, repo)."""
    found = []
    for root, dirs, files in os.walk(REPO):
        dirs[:] = [d for d in dirs if d != ".git"]
        for name in sorted(files):
            full = os.path.join(root, name)
            try:
                with open(full, encoding="utf-8") as handle:
                    text = handle.read(20000)
            except (OSError, UnicodeDecodeError):
                continue
            # The declaration is prose, and in a config file it is
            # prose inside comments, so the comment markers and the
            # line wrapping are both removed before matching.
            flat = re.sub(r"\s+", " ", text.replace("#", " "))
            match = WORKING_COPY.search(flat)
            if match:
                upstream, revision, owner, repo = match.groups()
                found.append((full, upstream, revision, owner, repo))
    return found


def unrecorded(local, upstream):
    """Lines of the working copy that differ and carry no marker.

    The Edison header is an insertion before the upstream text begins,
    so it is allowed without a marker; everything else that differs has
    to declare itself where it occurs or on the line before.
    """
    matcher = difflib.SequenceMatcher(None, upstream, local, autojunk=False)
    bad = []
    for tag, _, _, start, end in matcher.get_opcodes():
        if tag not in ("insert", "replace"):
            continue
        if tag == "insert" and start == 0:
            continue                       # the header block
        for n in range(start, end):
            line = local[n]
            before = local[n - 1] if n else ""
            if MARKER in line or MARKER in before:
                continue
            if not line.strip():
                continue
            bad.append((n + 1, line.rstrip()))
    return bad


def check_working_copies():
    """A003.  A working copy may not diverge without saying so."""
    copies = working_copies()
    if not copies:
        return 0
    failed, unreachable = [], 0
    for path, upstream, revision, owner, repo in copies:
        text = fetch_file(owner, repo, revision, upstream)
        if text is None:
            unreachable += 1
            continue
        if text is False:
            failed.append((path, 0, "the pinned upstream text is not there"))
            continue
        with open(path, encoding="utf-8") as handle:
            local = handle.read().split("\n")
        for line_no, line in unrecorded(local, text.split("\n")):
            failed.append((path, line_no, line))
    for path, line_no, line in failed:
        print("A003  %s:%d  %s diverges from the pinned text and no "
              "marker records it" % (os.path.relpath(path, REPO), line_no,
                                     line.strip()[:48]))
    if failed:
        return 1
    if unreachable:
        print("%d working cop(ies) could not be reached, so they were not "
              "checked." % unreachable)
        return 0
    print("%d working cop(ies) checked, no unrecorded divergence."
          % len(copies))
    return 0


def main():
    if not os.path.exists(EEP1):
        print("eeps/eep-0001.md is missing")
        return 2
    with open(EEP1, encoding="utf-8") as handle:
        eep1 = handle.read()

    revision = pin(eep1)
    if not revision:
        print("EEP 1 names no pinned revision")
        return 2

    pep1 = fetch(revision)
    if pep1 is None:
        print("The pinned PEP 1 could not be fetched, so the table was not")
        print("checked. EEP 1 pins %s." % revision)
        print("This check needs a network and keeps no copy, because EEP 1")
        print("chose a pin over a copy.")
        return check_pins() or check_working_copies()

    rows_text = table(eep1)
    if not rows_text:
        print("EEP 1 has no substitution table under a Substitutions "
              "heading")
        return 2
    rule = covered_by_rule(rows_text)
    missing = []
    for name, count in sorted(terms(pep1).items(), key=lambda kv: -kv[1]):
        if name in rows_text or name in rule:
            continue
        missing.append((name, count))

    rows = len([r for r in rows_text.strip().split("\n")
                if not set(r) <= set("|- ")]) - 1
    if missing:
        for name, count in missing:
            print("A001  eeps/eep-0001.md  %r appears %d time(s) in the "
                  "pinned PEP 1 and has no row" % (name, count))
        print("\n%d term(s) uncovered, %d row(s) in the table."
              % (len(missing), rows))
        check_pins()
        check_working_copies()
        return 1
    print("%d term(s) checked against %d row(s), none uncovered."
          % (len(terms(pep1)), rows))
    return check_pins() or check_working_copies()


if __name__ == "__main__":
    sys.exit(main())
