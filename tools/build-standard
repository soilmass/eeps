#!/usr/bin/env python3
"""Build the settled standard out of the EEPs that are Active.

An EEP is a decision document. It carries why a rule exists, what was
rejected on the way, and what is still open. Half the series by weight is
that reasoning, and it is worth keeping, but it is not what someone
building to the standard needs in front of them.

PEP 1 provides for the separation: "Once resolution is reached, a PEP is
considered a historical document rather than a living specification.
Formal documentation of the expected behavior should be maintained
elsewhere." EEP 1 substituted that for per-project documentation and left
the series-wide half unhoused. This fills it.

What binds is the Specification section, which PEP 1 defines as the
technical specification, detailed enough to build from. Only EEPs the
council has accepted are included: nothing the council has not accepted
should bind a project.

The output carries no timestamp. It is a function of the EEPs alone, so
that rebuilding an unchanged repository produces an unchanged file and
tools/check-eeps can refuse output that has drifted from its source.

Usage:
    tools/build-standard            # write the outputs
    tools/build-standard --check    # fail if the committed outputs differ

Exits 0 on success, 1 when --check finds a difference, 2 when the
repository cannot be read.
"""

import json
import os
import re
import sys
import textwrap

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
EEPS = os.path.join(REPO, "eeps")
DOC = os.path.join(REPO, "STANDARD.md")
INDEX = os.path.join(REPO, "standard.json")

HEADER = """# The standard

What building for Edison requires. Every rule here is in force, and every
one names the EEP that put it there.

This file is generated by `tools/build-standard` from the EEPs the council
has accepted. Do not edit it: a change belongs in the EEP the rule came
from, and anything written here directly is overwritten on the next build.

An EEP says why a rule exists, what was rejected on the way to it, and
what is still undecided. None of that is repeated here. Follow the link on
any section to read the argument behind it.
"""


def front_matter(text):
    """The headers of an EEP, as a dict, or None."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    headers = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return headers
        if ":" in line and not line[0].isspace():
            key, _, value = line.partition(":")
            headers[key.strip()] = value.strip()
    return None


def specification(text):
    """The Specification section's body, without its own heading.

    Walked line by line rather than matched, because EEP 3's Specification
    contains a copyable skeleton whose fenced block holds lines starting
    "## ". A pattern stops at the first of those and truncates the section
    mid-fence, which also leaves every later fence in the assembled
    document paired with the wrong partner.
    """
    out = []
    started = False
    fenced = False
    for line in text.split("\n"):
        if line.lstrip().startswith("```"):
            fenced = not fenced
        elif not fenced and line.startswith("## "):
            if started:
                break
            started = line.strip() == "## Specification"
            continue
        if started:
            out.append(line)
    return "\n".join(out).strip()


def cited_revisions(text):
    """Every external revision an EEP cites, from the URLs in it.

    Cited, not adopted. EEP 4 cites PEP 13 and says in the same breath
    that it "is read here as a checklist and is not adopted". A consumer
    that treated every revision here as binding would conform to a
    document Edison rejected, so the field says what it is and leaves
    adoption to the EEP that names it.
    """
    out = []
    seen = set()
    for owner, repo, sha, path in re.findall(
            r"github\.com/([\w.-]+)/([\w.-]+)/blob/([0-9a-f]{40})/(\S+?)`",
            text):
        key = (owner + "/" + repo, sha, path)
        if key in seen:
            continue
        seen.add(key)
        out.append({"repository": owner + "/" + repo,
                    "path": path, "revision": sha})
    return out


def read_eeps():
    """Every EEP, newest number last, with its headers and body."""
    out = []
    for name in sorted(os.listdir(EEPS)):
        if not re.match(r"^eep-\d{4}\.md$", name):
            continue
        with open(os.path.join(EEPS, name), encoding="utf-8") as handle:
            text = handle.read()
        headers = front_matter(text)
        if headers is None:
            continue
        out.append((name, headers, text))
    return out


def build():
    """Return the document and the index, as strings."""
    eeps = read_eeps()
    active = [e for e in eeps if e[1].get("Status") == "Active"]
    held = [e for e in eeps if e[1].get("Status") != "Active"]

    parts = [HEADER]
    if held:
        parts.append("## What is not here yet\n")
        parts.append(textwrap.fill(
            "These EEPs are written but the council has not accepted them, "
            "so nothing in them binds and nothing from them appears below.",
            width=79) + "\n")
        for name, headers, _ in held:
            parts.append("- [EEP %s - %s](eeps/%s), %s"
                         % (headers.get("EEP"), headers.get("Title"),
                            name, headers.get("Status", "?")))
        parts.append("")

    index = {"generated_by": "tools/build-standard", "eeps": []}
    for name, headers, text in active:
        number = headers.get("EEP")
        title = headers.get("Title")
        parts.append("## EEP %s - %s\n" % (number, title))
        accepted = headers.get("Resolution", "").split()[:1]
        parts.append("From [EEP %s](eeps/%s)%s.\n"
                     % (number, name,
                        ", accepted " + accepted[0] if accepted else ""))
        body = specification(text)
        parts.append(body if body else "_This EEP has no Specification._")
        parts.append("")
        index["eeps"].append({
            "eep": int(number),
            "title": title,
            "type": headers.get("Type"),
            "status": headers.get("Status"),
            "resolution": headers.get("Resolution", ""),
            "path": "eeps/" + name,
            "cited_revisions": cited_revisions(text),
        })

    doc = "\n".join(parts).rstrip() + "\n"
    doc = re.sub(r"\n{3,}", "\n\n", doc)
    return doc, json.dumps(index, indent=2, sort_keys=True) + "\n"


def main(argv):
    if not os.path.isdir(EEPS):
        print("eeps/ is missing")
        return 2
    doc, index = build()

    if "--check" in argv[1:]:
        stale = []
        for path, wanted in ((DOC, doc), (INDEX, index)):
            rel = os.path.relpath(path, REPO)
            if not os.path.exists(path):
                stale.append("%s is missing" % rel)
                continue
            with open(path, encoding="utf-8") as handle:
                if handle.read() != wanted:
                    stale.append("%s differs from what the EEPs produce" % rel)
        if stale:
            for line in stale:
                print(line)
            print("\nRun tools/build-standard to rebuild it.")
            return 1
        print("STANDARD.md and standard.json match the EEPs.")
        return 0

    for path, content in ((DOC, doc), (INDEX, index)):
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(content)
        print("wrote %s" % os.path.relpath(path, REPO))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
