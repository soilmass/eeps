# Build artefacts. Nothing generated by running the tools belongs in the
# repository. STANDARD.md and standard.json are generated too, but they
# are the point rather than a by-product, and tools/build-standard
# --check keeps them honest.
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Installing tools/floor leaves this behind. It is metadata setuptools
# regenerates on every install, so it is a by-product and not the point.
*.egg-info/
